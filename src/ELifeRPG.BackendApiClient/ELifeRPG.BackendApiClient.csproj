<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ELifeRPG.BackendApiClient</PackageId>
    <Description>Kiota-generated C# client for the ELifeRPG Central API (eliferpg-core).</Description>
    <RepositoryUrl>https://github.com/ELifeRPG/backend-api-client-dotnet</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" />
  </ItemGroup>

</Project>
